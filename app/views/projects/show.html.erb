<div class="max-w-3xl mx-auto py-10">
  <h1 class="text-2xl font-bold"><%= @project.name %></h1>
  <p class="text-gray-600 mb-6"><%= @project.description %></p>

  <%# turbo_stream_from subscribes this page to a broadcast channel.
      Any Task change anywhere (even from another user's browser)
      that calls broadcasts_to [@project, "tasks"] will be pushed
      here live, no polling or refresh needed. %>
  <%= turbo_stream_from @project, "tasks" %>

  <%# New task form, in a turbo frame so validation errors replace
      just this form, not the whole page %>
  <%= turbo_frame_tag "new_task_form" do %>
    <%= render "tasks/form", project: @project, task: @new_task %>
  <% end %>

  <div id="tasks" class="mt-6 space-y-2">
    <%= render @tasks %>
  </div>
</div>