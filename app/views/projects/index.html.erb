<div class="max-w-3xl mx-auto py-10 px-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-green-900">Your Projects</h1>
    <%= link_to "New Project", new_project_path,
          class: "bg-orange-500 text-white px-4 py-2 rounded-lg hover:bg-orange-600 transition font-medium" %>
  </div>

  <% if @projects.any? %>
    <div class="space-y-3">
      <% @projects.each do |project| %>
        <div class="bg-white border border-green-100 rounded-xl p-4 flex justify-between items-center shadow-sm hover:shadow-md transition">
          <div>
            <%= link_to project.name, project, class: "font-semibold text-lg text-green-900 hover:text-orange-600" %>
            <p class="text-sm text-slate-500"><%= project.description %></p>
          </div>
          <%# Completion badge — green background, orange text pops
              on top for a lively contrast %>
          <span class="text-sm font-medium bg-green-100 text-green-700 px-3 py-1 rounded-full">
            <%= project.completion_percentage %>% done
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-slate-500">No projects yet. Create your first one to get started.</p>
  <% end %>
</div>