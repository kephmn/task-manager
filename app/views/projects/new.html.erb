<div class="max-w-lg mx-auto py-16 px-4">
  <%# Card gets a subtle green border and a soft orange glow via
      shadow to feel warm rather than stark white %>
  <div class="bg-white rounded-xl shadow-lg shadow-orange-100 p-8 border border-green-100">
    <h1 class="text-2xl font-bold text-green-900 mb-1">New Project</h1>
    <p class="text-slate-500 text-sm mb-6">Give it a name and a quick description.</p>
    <%= render "form", project: @project %>
  </div>
</div>