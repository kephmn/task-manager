<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div class="bg-orange-50 text-orange-800 text-sm p-3 rounded-lg border border-orange-200">
      <ul class="list-disc list-inside">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-green-900 mb-1" %>
    <%# Focus ring in green ties the input state back to the primary
        brand color instead of a generic blue %>
    <%= f.text_field :name, class: "w-full border border-green-200 rounded-lg p-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-green-900 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full border border-green-200 rounded-lg p-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
  </div>

  <%# Orange button as the primary action — creates contrast against
      the green-dominant form so "Create" clearly stands out %>
  <%= f.submit class: "w-full bg-orange-500 text-white font-semibold py-2.5 rounded-lg hover:bg-orange-600 cursor-pointer transition shadow-sm" %>
<% end %>