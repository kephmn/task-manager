<div class="max-w-md mx-auto py-16 px-4">
  <div class="bg-white rounded-xl shadow-lg shadow-orange-100 p-8 border border-green-100">
    <h1 class="text-2xl font-bold text-green-900 mb-1">Log in</h1>
    <p class="text-slate-500 text-sm mb-6">Welcome back — enter your details below.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-5">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-green-900 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full border border-green-200 rounded-lg p-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-green-900 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full border border-green-200 rounded-lg p-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-green-300 text-green-600 focus:ring-green-500" %>
            <%= f.label :remember_me, class: "text-sm text-slate-600" %>
          </div>
        <% end %>

        <%= f.submit "Log in", class: "w-full bg-orange-500 text-white font-semibold py-2.5 rounded-lg hover:bg-orange-600 cursor-pointer transition shadow-sm" %>
      </div>
    <% end %>

    <div class="mt-6 text-sm text-slate-500 space-y-1">
      <%# render "devise/shared/links" pulls in Devise's default links
          (sign up, forgot password, etc.) — styled to match instead
          of the plain bullet list Devise ships by default %>
      <% if devise_mapping.registerable? %>
        <p><%= link_to "Don't have an account? Sign up", new_registration_path(resource_name), class: "text-green-700 hover:text-orange-600 font-medium" %></p>
      <% end %>
      <% if devise_mapping.recoverable? %>
        <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-green-700 hover:text-orange-600 font-medium" %></p>
      <% end %>
    </div>
  </div>
</div>