<%# dom_id generates a stable id like "task_5" — Turbo uses this to
    know WHICH element on the page to replace/update when a stream
    comes in for this specific task %>
<div id="<%= dom_id(task) %>" class="flex items-center justify-between border rounded p-3">
  <div class="flex items-center gap-3">
    <%# Toggling this checkbox submits instantly via Turbo (no page
        reload) because it's a button_to wrapped form hitting the
        toggle route, and Turbo intercepts standard form submissions
        automatically %>
    <%= button_to project_task_toggle_path(task.project, task), method: :patch, class: "contents" do %>
      <input type="checkbox" <%= "checked" if task.completed? %> class="pointer-events-none" />
    <% end %>

    <%# Turbo frame around the title makes it independently clickable
        to edit in place — see the edit link below %>
    <%= turbo_frame_tag dom_id(task, "title") do %>
      <span class="<%= "line-through text-gray-400" if task.completed? %>">
        <%= task.title %>
      </span>
    <% end %>

    <%# Stimulus controller attached here for the live overdue indicator
        — see app/javascript/controllers/due_date_controller.js %>
    <% if task.due_date.present? %>
      <span data-controller="due-date" data-due-date-value="<%= task.due_date.iso8601 %>" class="text-xs"></span>
    <% end %>
  </div>

  <div class="flex items-center gap-2 text-sm">
    <span class="text-gray-500"><%= task.assignee&.email || "Unassigned" %></span>
    <%= link_to "Edit", edit_project_task_path(task.project, task), class: "text-blue-600" %>
    <%= button_to "Delete", project_task_path(task.project, task), method: :delete, class: "text-red-600" %>
  </div>
</div>